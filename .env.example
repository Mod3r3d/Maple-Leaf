# ═══════════════════════════════════════════════════════════════
#  Maple Leaf — Mẫu cấu hình biến môi trường
#  Cách dùng:  copy file này thành .env  rồi điền giá trị của bạn.
#    - Windows:  copy .env.example .env
#    - Linux/macOS:  cp .env.example .env
#  ⚠️ KHÔNG commit file .env (đã được .gitignore chặn).
# ═══════════════════════════════════════════════════════════════

# ─── BẮT BUỘC ───────────────────────────────────────────────────
# Token bot lấy tại https://discord.com/developers/applications
DISCORD_TOKEN=

# ─── Cơ sở dữ liệu ──────────────────────────────────────────────
# Mặc định dùng SQLite (không cần cài gì thêm).
DATABASE_PATH=data/mapleleaf.db
# (Tùy chọn) Dùng PostgreSQL thay cho SQLite. Nếu điền, DATABASE_PATH sẽ bị bỏ qua.
# Ví dụ: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# ─── Log & Debug ────────────────────────────────────────────────
DEBUG=False
LOG_LEVEL=INFO

# ─── Bộ đệm & thời gian chờ ─────────────────────────────────────
CACHE_TTL_SECONDS=3600
ENKA_TIMEOUT_SECONDS=12

# ─── Tự động hoá (Automation) ───────────────────────────────────
# Bật/tắt toàn bộ lớp chạy nền.
AUTOMATION_ENABLED=True
# "live" = gọi API thật | "dry-run" = chỉ giả lập, không đổi mã thật.
AUTOMATION_MODE=live
# Múi giờ dùng cho lịch chạy nền.
TIMEZONE=Asia/Ho_Chi_Minh
# (Tùy chọn) Khoá mã hoá Fernet 32-byte base64 cho cookie.
# Nếu để trống, bot sẽ tự sinh và lưu tại data/.secret.key.
# Sinh khoá mới:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Lịch chạy nền ──────────────────────────────────────────────
CHECKIN_CRON_HOUR=0
CHECKIN_CRON_MINUTE=5
GIFTCODE_SCAN_INTERVAL_MINUTES=60
MIMO_SCAN_INTERVAL_MINUTES=60
WEB_EVENT_SCAN_INTERVAL_MINUTES=120

# ─── Giới hạn tốc độ & đồng thời ────────────────────────────────
MAX_CONCURRENT_AUTOMATION_TASKS=5
PROVIDER_REQUEST_DELAY_SECONDS=1.5

# ─── Quản trị ───────────────────────────────────────────────────
# Danh sách Discord User ID được dùng lệnh /admin, cách nhau bởi dấu phẩy.
# Ví dụ: ADMIN_USER_IDS=123456789012345678,987654321098765432
ADMIN_USER_IDS=

# ─── Màu Embed (hệ thập lục phân, 0xRRGGBB) ─────────────────────
GENSHIN_COLOR=0x5BC0BE
HSR_COLOR=0x9370DB
PRIMARY_COLOR=0x3498DB
SUCCESS_COLOR=0x2ECC71
ERROR_COLOR=0xE74C3C
WARNING_COLOR=0xF39C12

# ─── Emoji tuỳ biến (TÙY CHỌN) ──────────────────────────────────
# Mặc định bot dùng emoji Unicode để chạy đúng ở MỌI server Discord.
# Nếu server của bạn có emoji tuỳ biến, dán NGUYÊN thẻ emoji vào đây.
# Lấy thẻ emoji: bật Developer Mode trong Discord → chuột phải emoji → Copy Link,
# hoặc gõ \:tên_emoji trong chat rồi gửi để xem thẻ <:tên:id>.
# Ví dụ:
#   GENSHIN_EMOJI=<:genshin_icon:1556606822314672142>
#   HSR_EMOJI=<:hsr_icon:1556606824491389010>
GENSHIN_EMOJI=
HSR_EMOJI=
